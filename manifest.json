{
  "manifest_version": 3,
  "name": "Flow Bulk Video Exporter",
  "version": "1.7.0",
  "description": "Bulk-download Google Flow videos at 720p or use Flow's own 1080p upscale export.",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/*",
    "https://flow-content.google/*",
    "https://*.googleusercontent.com/*",
    "https://*.googlevideo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Flow Bulk Video Exporter"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/flow*",
        "https://labs.google/fx/*/tools/flow*",
        "https://labs.google/fx/*/flow*"
      ],
      "js": [
        "core.js",
        "modern-flow.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
