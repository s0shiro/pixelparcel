{
  "manifest_version": 3,
  "name": "PixelParcel for Google Flow™",
  "version": "1.9.3",
  "description": "Bulk-download Google Flow videos at 720p or use Flow's own 1080p upscale export.",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "notifications",
    "sidePanel"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/*",
    "https://flow-content.google/*",
    "https://*.googleusercontent.com/*",
    "https://*.googlevideo.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open PixelParcel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/flow*",
        "https://labs.google/fx/*/tools/flow*",
        "https://labs.google/fx/*/flow*"
      ],
      "js": [
        "core.js",
        "modern-flow.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
